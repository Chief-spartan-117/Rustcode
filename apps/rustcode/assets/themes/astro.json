{
	"name": "Astro",
	"type": "dark",
	"colors": {
		"editor.background": "#0d0b14",
		"editor.foreground": "#d7d3e8",
		"editor.selectionBackground": "#2d2a4a",
		"editor.lineHighlightBackground": "#161325",
		"editorCursor.foreground": "#ff5d01",
		"editorLineNumber.foreground": "#4a4566",
		"editorLineNumber.activeForeground": "#b8b2d6",
		"editor.findMatchBackground": "#5b3a8a",
		"editor.findMatchHighlightBackground": "#3b2a5a",
		"editorIndentGuide.background1": "#221e36",
		"titleBar.activeBackground": "#0a0810",
		"titleBar.activeForeground": "#b8b2d6",
		"activityBar.background": "#0a0810",
		"activityBar.foreground": "#e6e2f5",
		"sideBar.background": "#100d1b",
		"sideBar.foreground": "#c4bfdc",
		"sideBar.border": "#1c1830",
		"statusBar.background": "#ff5d01",
		"statusBar.foreground": "#ffffff",
		"editorGroupHeader.tabsBackground": "#0a0810",
		"tab.activeBackground": "#0d0b14",
		"tab.inactiveBackground": "#0a0810",
		"tab.activeForeground": "#ffffff",
		"tab.inactiveForeground": "#6f6a8c",
		"tab.border": "#1c1830",
		"panel.background": "#0d0b14",
		"panel.border": "#1c1830",
		"input.background": "#161325",
		"input.border": "#2a2545",
		"list.hoverBackground": "#1a1630",
		"list.activeSelectionBackground": "#2d2a4a",
		"list.activeSelectionForeground": "#ffffff",
		"quickInputList.focusBackground": "#2d2a4a",
		"focusBorder": "#ff5d01",
		"button.background": "#ff5d01",
		"button.foreground": "#ffffff",
		"editorWidget.background": "#100d1b",
		"editorSuggestWidget.background": "#100d1b",
		"editorSuggestWidget.selectedBackground": "#2d2a4a",
		"editorHoverWidget.background": "#100d1b",
		"scrollbarSlider.background": "#4a456666",
		"scrollbarSlider.hoverBackground": "#6a608a77",
		"scrollbarSlider.activeBackground": "#8a7fb099"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5f5a7a", "fontStyle": "italic" } },
		{ "scope": "string", "settings": { "foreground": "#9ece6a" } },
		{ "scope": "constant.numeric", "settings": { "foreground": "#ffb86c" } },
		{ "scope": "constant.language, constant.character, constant.other", "settings": { "foreground": "#ffb86c" } },
		{ "scope": "keyword, storage.type, storage.modifier", "settings": { "foreground": "#bd93f9" } },
		{ "scope": "keyword.operator", "settings": { "foreground": "#89ddff" } },
		{ "scope": "entity.name.function, support.function, meta.function-call", "settings": { "foreground": "#ff7a2f" } },
		{ "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#7dcfff" } },
		{ "scope": "variable, variable.other", "settings": { "foreground": "#e0def4" } },
		{ "scope": "variable.parameter", "settings": { "foreground": "#f1c6ff" } },
		{ "scope": "entity.name.tag, markup.heading", "settings": { "foreground": "#ff5d01" } },
		{ "scope": "entity.other.attribute-name", "settings": { "foreground": "#bd93f9" } },
		{ "scope": "constant.character.escape", "settings": { "foreground": "#89ddff" } },
		{ "scope": "punctuation", "settings": { "foreground": "#9d97be" } }
	]
}
