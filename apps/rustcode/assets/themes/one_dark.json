{
	"name": "One Dark",
	"type": "dark",
	"colors": {
		"editor.background": "#282c34",
		"editor.foreground": "#abb2bf",
		"editor.selectionBackground": "#3e4451",
		"editor.lineHighlightBackground": "#2c313c",
		"editorCursor.foreground": "#528bff",
		"editorLineNumber.foreground": "#636d83",
		"editorLineNumber.activeForeground": "#abb2bf",
		"editor.findMatchBackground": "#42557b",
		"editor.findMatchHighlightBackground": "#314365",
		"editorIndentGuide.background1": "#3b4048",
		"editorWhitespace.foreground": "#3b4048",
		"titleBar.activeBackground": "#21252b",
		"titleBar.activeForeground": "#9da5b4",
		"activityBar.background": "#21252b",
		"activityBar.foreground": "#d7dae0",
		"sideBar.background": "#21252b",
		"sideBar.foreground": "#abb2bf",
		"sideBar.border": "#181a1f",
		"statusBar.background": "#21252b",
		"statusBar.foreground": "#9da5b4",
		"editorGroupHeader.tabsBackground": "#21252b",
		"tab.activeBackground": "#282c34",
		"tab.inactiveBackground": "#21252b",
		"tab.activeForeground": "#d7dae0",
		"tab.inactiveForeground": "#6b717d",
		"tab.border": "#181a1f",
		"panel.background": "#21252b",
		"panel.border": "#181a1f",
		"input.background": "#1d1f23",
		"input.border": "#181a1f",
		"list.hoverBackground": "#2c313a",
		"list.activeSelectionBackground": "#2c313a",
		"list.activeSelectionForeground": "#d7dae0",
		"quickInputList.focusBackground": "#2c313a",
		"focusBorder": "#528bff",
		"button.background": "#4d78cc",
		"button.foreground": "#ffffff",
		"editorWidget.background": "#21252b",
		"editorSuggestWidget.background": "#21252b",
		"editorSuggestWidget.selectedBackground": "#2c313a",
		"editorHoverWidget.background": "#21252b",
		"scrollbarSlider.background": "#4e566666",
		"scrollbarSlider.hoverBackground": "#5a637577",
		"scrollbarSlider.activeBackground": "#747d9199"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5c6370", "fontStyle": "italic" } },
		{ "scope": "string", "settings": { "foreground": "#98c379" } },
		{ "scope": "constant.numeric", "settings": { "foreground": "#d19a66" } },
		{ "scope": "constant.language, constant.character, constant.other", "settings": { "foreground": "#d19a66" } },
		{ "scope": "keyword, storage.type, storage.modifier", "settings": { "foreground": "#c678dd" } },
		{ "scope": "keyword.operator", "settings": { "foreground": "#56b6c2" } },
		{ "scope": "entity.name.function, support.function, meta.function-call", "settings": { "foreground": "#61afef" } },
		{ "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#e5c07b" } },
		{ "scope": "variable, variable.other", "settings": { "foreground": "#e06c75" } },
		{ "scope": "variable.parameter", "settings": { "foreground": "#abb2bf" } },
		{ "scope": "entity.name.tag, markup.heading", "settings": { "foreground": "#e06c75" } },
		{ "scope": "entity.other.attribute-name", "settings": { "foreground": "#d19a66" } },
		{ "scope": "constant.character.escape", "settings": { "foreground": "#56b6c2" } },
		{ "scope": "punctuation", "settings": { "foreground": "#abb2bf" } }
	]
}
