{
  "console.log": {"prefix": "clg", "body": "console.log($0);"},
  "function": {"prefix": "fn", "body": ["function ${1:name}(${2}) {", "  $0", "}"]},
  "arrow function": {"prefix": "afn", "body": ["const ${1:name} = (${2}) => {", "  $0", "};"]},
  "import": {"prefix": "imp", "body": "import ${2:name} from '${1:module}';"},
  "import named": {"prefix": "impn", "body": "import { $2 } from '${1:module}';"},
  "export default": {"prefix": "expd", "body": "export default ${1:name};"},
  "for of": {"prefix": "forof", "body": ["for (const ${1:item} of ${2:items}) {", "  $0", "}"]},
  "forEach": {"prefix": "fore", "body": ["${1:items}.forEach((${2:item}) => {", "  $0", "});"]},
  "try catch": {"prefix": "tryc", "body": ["try {", "  $1", "} catch (${2:error}) {", "  $0", "}"]},
  "async function": {"prefix": "afunc", "body": ["async function ${1:name}(${2}) {", "  $0", "}"]},
  "fetch": {"prefix": "fetch", "body": ["const ${1:response} = await fetch(${2:url});", "const ${3:data} = await ${1}.json();"]},
  "setTimeout": {"prefix": "st", "body": ["setTimeout(() => {", "  $0", "}, ${1:1000});"]},
  "promise": {"prefix": "prom", "body": ["new Promise((resolve, reject) => {", "  $0", "})"]},
  "describe": {"prefix": "desc", "body": ["describe('${1:name}', () => {", "  it('${2:works}', () => {", "    $0", "  });", "});"]}
}
