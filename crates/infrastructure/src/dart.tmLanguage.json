{
  "scopeName": "source.dart",
  "name": "Dart",
  "patterns": [
    {"include": "#comments"},
    {"include": "#directives"},
    {"include": "#annotations"},
    {"include": "#strings"},
    {"include": "#numbers"},
    {"include": "#constants"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#calls"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {"name": "comment.block.documentation.dart", "begin": "/\\*\\*(?!/)", "end": "\\*/"},
        {"name": "comment.block.dart", "begin": "/\\*", "end": "\\*/"},
        {"name": "comment.line.documentation.dart", "match": "///.*$"},
        {"name": "comment.line.double-slash.dart", "match": "//.*$"}
      ]
    },
    "directives": {
      "patterns": [
        {"name": "meta.declaration.dart", "match": "^\\s*(import|export|part\\s+of|part|library)\\b", "captures": {"1": {"name": "keyword.other.import.dart"}}},
        {"name": "keyword.other.import.dart", "match": "\\b(show|hide|deferred|as)\\b(?=\\s)"}
      ]
    },
    "annotations": {
      "patterns": [
        {"name": "storage.type.annotation.dart", "match": "@[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?"}
      ]
    },
    "strings": {
      "patterns": [
        {"name": "string.interpolated.triple.dart", "begin": "r?\"\"\"", "end": "\"\"\"", "patterns": [{"include": "#interpolation"}, {"include": "#escapes"}]},
        {"name": "string.interpolated.triple.single.dart", "begin": "r?'''", "end": "'''", "patterns": [{"include": "#interpolation"}, {"include": "#escapes"}]},
        {"name": "string.quoted.raw.dart", "begin": "r\"", "end": "\""},
        {"name": "string.quoted.raw.single.dart", "begin": "r'", "end": "'"},
        {"name": "string.quoted.double.dart", "begin": "\"", "end": "\"|$", "patterns": [{"include": "#interpolation"}, {"include": "#escapes"}]},
        {"name": "string.quoted.single.dart", "begin": "'", "end": "'|$", "patterns": [{"include": "#interpolation"}, {"include": "#escapes"}]}
      ]
    },
    "escapes": {
      "patterns": [
        {"name": "constant.character.escape.dart", "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|.)"}
      ]
    },
    "interpolation": {
      "patterns": [
        {"name": "meta.embedded.expression.dart", "begin": "\\$\\{", "end": "\\}", "beginCaptures": {"0": {"name": "punctuation.definition.template-expression.begin.dart"}}, "endCaptures": {"0": {"name": "punctuation.definition.template-expression.end.dart"}}, "patterns": [{"include": "$self"}]},
        {"name": "variable.other.interpolated.dart", "match": "\\$[A-Za-z_][A-Za-z0-9_]*"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.hex.dart", "match": "\\b0[xX][0-9A-Fa-f_]+\\b"},
        {"name": "constant.numeric.dart", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?\\b"}
      ]
    },
    "constants": {
      "patterns": [
        {"name": "constant.language.dart", "match": "\\b(true|false|null)\\b"},
        {"name": "variable.language.dart", "match": "\\b(this|super)\\b"}
      ]
    },
    "keywords": {
      "patterns": [
        {"name": "keyword.control.dart", "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|rethrow|assert|await|yield|async|sync|on)\\b"},
        {"name": "keyword.operator.dart", "match": "\\b(is|in|new)\\b"},
        {"name": "storage.type.class.dart", "match": "\\b(class|mixin|enum|extension|typedef|interface|base|sealed)\\b"},
        {"name": "storage.modifier.dart", "match": "\\b(abstract|static|final|const|late|var|external|factory|covariant|required|get|set|operator|with|extends|implements|library|part|of)\\b"},
        {"name": "storage.type.primitive.dart", "match": "\\b(void|dynamic|int|double|num|bool|String|Object|List|Map|Set|Future|Stream|Iterable|Function|Type|Null|Never)\\b"}
      ]
    },
    "types": {
      "patterns": [
        {"name": "entity.name.type.dart", "match": "\\b_?[A-Z][A-Za-z0-9_]*\\b"}
      ]
    },
    "calls": {
      "patterns": [
        {"name": "entity.name.function.dart", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*(<[^>(]*>)?\\()"}
      ]
    },
    "operators": {
      "patterns": [
        {"name": "keyword.operator.dart", "match": "=>|\\?\\?=?|\\?\\.|\\.\\.\\.?\\??|\\?|:|[-+*/%&|^~!<>=]=?|<<=?|>>>?=?"}
      ]
    }
  }
}
